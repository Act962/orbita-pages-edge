# IP dedicado da portaria (segundo IP do servidor). É o valor do registro A que o cliente cria.
EDGE_BIND_IP=

# Origem do app principal, com protocolo e sem barra no fim.
APP_ORIGIN=https://orbita.nasaex.com

# Mesmo valor de PAGES_EDGE_SECRET no app principal. Gerar com: openssl rand -hex 32
PAGES_EDGE_SECRET=

# Contato usado pelo Let's Encrypt para avisos de certificado.
ACME_EMAIL=
